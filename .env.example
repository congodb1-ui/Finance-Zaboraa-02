# Browser-exposed Supabase project URL (from Supabase Project Settings -> API)
VITE_SUPABASE_URL=

# Browser-exposed Supabase anon public key (safe for client with RLS enabled)
VITE_SUPABASE_ANON_KEY=

# Browser-exposed Google OAuth Web Client ID for Direct GIS Sign-In (finance.zaboraa.com)
VITE_GOOGLE_CLIENT_ID=

# Public base URL of the Zaboraa Finance portal
VITE_APP_URL=https://finance.zaboraa.com

# Server-only Supabase project URL fallback (keep identical to VITE_SUPABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=

# Server-only Supabase anon key fallback (keep identical to VITE_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public portal URL fallback used by server helpers
NEXT_PUBLIC_APP_URL=https://finance.zaboraa.com

# Server-only Google OAuth Web Client ID (defaults to VITE_GOOGLE_CLIENT_ID if unset)
GOOGLE_CLIENT_ID=

# Server-only Supabase service role key used to mint verified GIS sessions and write audit logs (NEVER prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=

# Server-only comma-separated allowlist of Google emails permitted to sign in (e.g. owner@gmail.com)
ALLOWED_EMAILS=

# Server-only 32+ character random secret for AES-256-GCM encryption of PAN, bank accounts, and IBANs (NEVER prefix with VITE_)
ENCRYPTION_KEY=

# Server-only Google Gemini API key for AI categorization, chat, anomalies, and monthly reports
GEMINI_API_KEY=

# Server-only Gemini Flash model ID for categorization, cleaning, anomalies, and chat
GEMINI_MODEL_FLASH=gemini-3.5-flash-lite

# Server-only Gemini Pro-tier model ID for monthly financial report generation
GEMINI_MODEL_PRO=gemini-3.8-flash

# Server-only Google OAuth Client Secret (enables offline refresh tokens for 6-hour Gmail cron sync; NEVER prefix with VITE_)
GOOGLE_CLIENT_SECRET=

# Optional: set to "true" to delegate /api/gmail/sync to deployed Supabase Edge Function gmail-sync
USE_SUPABASE_EDGE_GMAIL_SYNC=false