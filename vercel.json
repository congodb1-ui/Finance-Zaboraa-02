{
  "routes": [
    {
      "src": "/api/payment-instructions/(?<id>[^/]+)/reveal",
      "dest": "/api/payment-instructions/[id]/reveal.ts"
    },
    {
      "src": "/api/payment-instructions/(?<id>[^/]+)",
      "dest": "/api/payment-instructions/[id].ts"
    },
    {
      "src": "/api/transactions/(?<id>[^/]+)",
      "dest": "/api/transactions/[id].ts"
    },
    {
      "src": "/api/(.*)",
      "dest": "/api/$1.ts"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
